# ===== 必須 =====
# HIBITOに入るための合言葉（自分で決める。長めの文字列がおすすめ）
HIBITO_PASSCODE=

# Gemini API キー（無料）: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase（無料）: Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== 任意 =====
# Geminiのモデル（無料枠のあるFlash系）
# GEMINI_MODEL=gemini-3.5-flash

# 天気の地点（既定は那覇）
# HIBITO_PLACE=那覇
# HIBITO_LAT=26.2124
# HIBITO_LON=127.6809

# 将来Claudeに切り替えるとき（有料）
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ローカルでDBやAIなしに画面だけ確認する（npm run dev のときだけ有効）
# HIBITO_DEMO=1
